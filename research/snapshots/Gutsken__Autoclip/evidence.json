  "commit": {
    "sha": "5d0eac36fa615b79dd2104083bf273a96f8d68bb",
    "node_id": "C_kwDOTzpJ79oAKDVkMGVhYzM2ZmE2MTViNzlkZDIxMDQwODNiZjI3M2E5NmY4ZDY4YmI",
    "commit": {
      "author": {
        "name": "artbyjazi",
        "email": "133226464+artbyjazi@users.noreply.github.com",
        "date": "2026-08-01T00:36:07Z"
      },
      "committer": {
        "name": "artbyjazi",
        "email": "133226464+artbyjazi@users.noreply.github.com",
        "date": "2026-08-01T00:36:07Z"
      },
      "message": "Make the gpu extra installable on macOS\n\n'pip install autoclip[gpu]' failed to resolve on macOS: the nvidia-cublas and\nnvidia-cudnn wheels are not published for Darwin. That is the exact command\ndoctor prints when it cannot see a GPU, so a Mac user following the advice hit\na resolver error rather than a useful outcome.\n\nThe wheels now carry a platform_system != 'Darwin' marker, so the extra\ninstalls nothing on macOS \u2014 which is correct, since there is no CUDA there and\nApple Silicon takes the CPU path regardless.\n\nAlso restores the optional-extras section the README rewrite dropped, so [gpu]\nand [diarization] are documented rather than only mentioned in passing.\n\nVerified marker evaluation for Windows, Linux, and Darwin.\n\nCo-Authored-By: Claude Opus 5 <noreply@anthropic.com>",
      "tree": {
        "sha": "947b33d746f6e458a89ae7a8b38b8e6c4acdafb0",
        "url": "https://api.github.com/repos/Gutsken/Autoclip/git/trees/947b33d746f6e458a89ae7a8b38b8e6c4acdafb0"
      },
      "url": "https://api.github.com/repos/Gutsken/Autoclip/git/commits/5d0eac36fa615b79dd2104083bf273a96f8d68bb",
      "comment_count": 0,
