{
  "name": "autoclip-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest",
    "check": "vue-tsc --noEmit",
    "tauri": "tauri",
    "desktop:build": "tauri build --no-bundle",
    "desktop:dev": "tauri dev",
    "desktop:build:local": "tauri build --debug --no-bundle"
  },
  "dependencies": {
    "@lucide/vue": "^1.55.0",
    "reka-ui": "^2.11.0",
    "vue": "^3.5.43",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.13"
  }
}
