{
  "name": "autoclip-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest",
    "test:run": "vitest run",
    "check": "vue-tsc --noEmit",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "format": "prettier --write \"src/**/*.{vue,ts,css}\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{vue,ts,css}\" \"tests/**/*.ts\"",
    "tauri": "tauri",
    "desktop:build": "tauri build --no-bundle",
    "desktop:bundle": "tauri build",
    "desktop:dev": "tauri dev",
    "desktop:build:local": "tauri build --debug --no-bundle"
  },
  "dependencies": {
    "@lucide/vue": "^1.55.0",
    "element-plus": "^2.9.0",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.2",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "unplugin-auto-import": "^19.0.0",
    "unplugin-vue-components": "^28.0.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  }
}
