{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AutoClip",
  "version": "0.1.0",
  "identifier": "org.autoclip.editor",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": [],
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "externalBin": [
      "bin/autoclip-engine"
    ],
    "icon": [
      "icons/icon.ico"
    ]
  }
}
